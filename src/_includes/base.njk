<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
  <title>{{ title or site.name }}</title>
  <link rel="icon" href="/favicon/r.gif" type="image/gif">
  {% if home %}
  {# Decide before first paint whether the intro plays, so it never flashes.
      Skipped when it already played this session (site.intro_repeat = "session"),
      or when the page opens straight on a project (/#slug). #}
  <script>
    (function (d) {
      var c = d.documentElement.classList, key = 'intro-played', repeat = {{ (site.intro_repeat or "session") | dump | safe }};
      c.add('js');
      try {
        if (location.hash.length > 1 || (repeat === 'session' && sessionStorage.getItem(key))) { c.add('intro-skip'); return; }
        if (repeat === 'session') sessionStorage.setItem(key, '1');
      } catch (e) {}
      c.add('intro-on');
    })(document);
  </script>
  {% endif %}
  {# Preload the main font file so text renders in Allo as early as possible. Update or remove this if you change fonts in fonts.css. #}
  <link rel="preload" href="/assets/fonts/allo/AlloVariable.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/assets/css/fonts.css">
  {% if home %}
  <link rel="stylesheet" href="/home.css">
  <link rel="stylesheet" href="/assets/css/motion.css">
  <link rel="stylesheet" href="/assets/css/intro.css">
  <script defer src="https://cdnjs.cloudflare.com/ajax/libs/tone/14.8.39/Tone.js"></script>
  <link rel="stylesheet" type="text/css" href="https://unpkg.com/@phosphor-icons/web@2.1.1/src/regular/style.css">
  {% endif %}
</head>
<body>
  {% if home %}
  {# Intro animation. Text comes from site.json → intro_text (editable in the CMS). Styling: assets/css/intro.css #}
  <div class="intro" id="intro" data-intro-text="{{ (site.intro_text or site.name) | escape }}" aria-hidden="true">
    <div class="intro-stage"></div>
  </div>
  <script src="/assets/intro.js"></script>
  {% endif %}
  {{ content | safe }}
</body>
</html>
